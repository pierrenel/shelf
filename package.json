{
  "name": "shelf",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "dev": "vite --host 0.0.0.0",
    "test": "tsc -p tsconfig.server.json && node --test dist/tests/*.test.js",
    "test:smoke": "node dist/tests/smoke.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.0.0",
    "playwright": "1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
