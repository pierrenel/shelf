# Number of simultaneous page captures (1–8).
CAPTURE_CONCURRENCY=2
# Linux owner of ./data; run id -u and id -g to check these values.
SHELF_UID=1000
SHELF_GID=1000
# Maximum full screenshot height in pixels (900–25000).
MAX_FULLPAGE_HEIGHT=16000
# Enable layout/reveal fixes for difficult animated pages; recorded per capture.
CAPTURE_REPAIR=false
# Model tagging: openai-compatible, anthropic, or none. Heuristic tags always run.
TAGGER_PROVIDER=none
# API root for the provider (OpenAI-compatible default: https://api.openai.com/v1).
TAGGER_BASE_URL=
# Provider secret; never sent to the browser. Optional for some local OpenAI-compatible runtimes.
TAGGER_API_KEY=
# Vision-capable model name. Required when TAGGER_PROVIDER is not none.
TAGGER_MODEL=
# Reserved: Raindrop API token for phase 3.
RAINDROP_TOKEN=
# Reserved: collection to synchronise in phase 3.
RAINDROP_COLLECTION_ID=
# Reserved: sync interval in minutes.
RAINDROP_SYNC_MINUTES=30
